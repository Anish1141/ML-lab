# Assignment 4A: K-Means clustering on Iris, number of clusters via Elbow method
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.cluster import KMeans

# Load Dataset
df = pd.read_csv("Iris.csv")
X = df.iloc[:, 1:5]

# Elbow Method (Find Optimal K)
wcss = [
    KMeans(n_clusters=k, n_init=10,
           random_state=42).fit(X).inertia_
    for k in range(1, 11)
]

# Plot Elbow Graph
plt.plot(range(1, 11), wcss, marker='o')
plt.title("Elbow Method")
plt.xlabel("Clusters")
plt.ylabel("WCSS")
plt.show()

# Apply K-Means Clustering
df["Cluster"] = KMeans(
    n_clusters=3,
    n_init=10,
    random_state=42
).fit_predict(X)

# Visualize Clusters
plt.scatter(
    X.iloc[:, 0], X.iloc[:, 1],
    c=df.Cluster, cmap="viridis"
)
plt.xlabel("Sepal Length")
plt.ylabel("Sepal Width")
plt.title("K-Means Clustering")
plt.show()
